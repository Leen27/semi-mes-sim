{
  "name": "semi-mes-sim",
  "version": "0.0.1",
  "private": true,
  "description": "半导体 MES 系统 3D 仿真 - Semiconductor MES 3D Simulation",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
