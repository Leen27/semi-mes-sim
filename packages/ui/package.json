{
  "name": "@semi/ui",
  "version": "0.0.1",
  "private": true,
  "description": "共享 Vue UI 组件库",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vue-tsc --declaration --emitDeclarationOnly && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@semi/config": "workspace:*",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.2.8"
  }
}
